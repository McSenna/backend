# ============================================================
# MaslogCare Backend Environment Configuration
# Copy this file to .env and configure your values.
# NEVER commit .env into version control.
# ============================================================

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/maslogcare

# Server Configuration
PORT=5000
NODE_ENV=development
REQUEST_BODY_LIMIT=10mb

# Timezone for mission hours, day boundaries and appointment times in e-mails.
# Defaults to Asia/Manila; only change it if the health center is elsewhere.
# APP_TIMEZONE=Asia/Manila

# Set when the API runs behind a reverse proxy (nginx, Render, Railway, ...) so
# rate limits see the real client IP. Use the number of proxy hops, e.g. 1.
# Leave unset otherwise: X-Forwarded-For is then ignored, since any client can forge it.
# TRUST_PROXY=1

# Browser origins allowed to call this API (comma separated).
# Only enforced when NODE_ENV=production; development allows all origins so
# Expo's moving dev-server port keeps working. Leave unset in production and
# browser clients on other origins will be refused by CORS.
# CLIENT_ORIGINS=https://maslogcare.ph,https://admin.maslogcare.ph

# JWT Secret (Use a strong random 256-bit string in production)
JWT_SECRET=replace_with_a_secure_jwt_secret_key_in_production

# Default Admin Seed (Optional, used on initial database seed)
ADMIN_DEFAULT_PASSWORD=MaslogAdmin@2025

# ============================================================
# Email / OTP Delivery Configuration
# ============================================================
# Enable or disable real email delivery.
# In development, setting EMAIL_ENABLED=false logs OTPs to the terminal
# and bypasses external SMTP quotas completely.
EMAIL_ENABLED=true

# Provider mode: "smtp" (standard SMTP), "gmail" (Gmail App Password), or "mock"
EMAIL_PROVIDER=smtp

# SMTP Host & Port
# Standard SMTP options:
# - smtp.gmail.com (Port 465 SSL or 587 STARTTLS)
# - smtp.resend.com (Port 465 or 587)
# - smtp.sendgrid.net (Port 587)
# - smtp-relay.brevo.com (Port 587)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true

# SMTP Credentials (Both EMAIL_PASSWORD and EMAIL_PASS are supported)
EMAIL_USER=your_email@domain.com
EMAIL_PASSWORD=your_app_password_or_smtp_key
# EMAIL_PASS=your_app_password_or_smtp_key

# Sender identity
EMAIL_FROM=noreply@maslogcare.ph
EMAIL_FROM_NAME=MaslogCare Health System

# Security / TLS Settings (Set to true in production)
EMAIL_TLS_REJECT_UNAUTHORIZED=true

# Rate Limiting & Cooldowns
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5

# ============================================================
# Resident Locality
# ============================================================
# MaslogCare serves a single barangay. The sign-up form shows the barangay as
# a locked field and the server overrides whatever the client sends, so this is
# the only place the value is set. City and province are defaults the resident
# may correct on the form.
RESIDENT_BARANGAY=Maslog
RESIDENT_CITY_MUNICIPALITY=Legazpi City
RESIDENT_PROVINCE=Albay
