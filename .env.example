MONGO_URI=mongodb://localhost:27017/maslogcare

# Database stage limits in milliseconds. These are per-stage limits, not an
# end-to-end HTTP deadline. The client keeps a 15-second total request budget.
DB_SELECTION_TIMEOUT_MS=5000
DB_CONNECT_TIMEOUT_MS=5000
DB_POOL_WAIT_TIMEOUT_MS=2000
DB_SOCKET_TIMEOUT_MS=5000
# Long offline migrations can override DB_SOCKET_TIMEOUT_MS for that invocation.

# Server Configuration
PORT=3000
NODE_ENV=development
REQUEST_BODY_LIMIT=10mb

JWT_SECRET=replace_with_a_secure_jwt_secret_key_in_production

# MongoDB _id of the only administrator who may change resident web access.
# Not the ADM-... code shown in the app: that is derived from this id for display.
# Empty, malformed, or not an admin account means nobody can change it.
RESIDENT_WEB_ACCESS_ADMIN_ID=

# Default Admin Seed (Optional, used on initial database seed)
# Passwords for the default staff accounts, used only when the account is first
# created. An account whose variable is empty is not created. Never commit real values.
ADMIN_DEFAULT_PASSWORD=
ADMIN2_DEFAULT_PASSWORD=
MIDWIFE_DEFAULT_PASSWORD=
DOCTOR_DEFAULT_PASSWORD=
BHW_DEFAULT_PASSWORD=

EMAIL_ENABLED=true

EMAIL_PROVIDER=brevo

# Brevo transactional email API key. Server only, never commit a real value.
BREVO_API_KEY=

# Sender address, verified in Brevo under Senders or through an authenticated
# domain. The sender name is always MaslogCare.
BREVO_SENDER_EMAIL=barangay61.maslog@brevosend.com

# Rate Limiting & Cooldowns
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5

# ============================================================
# Resident Locality
# ============================================================
RESIDENT_BARANGAY=Maslog
RESIDENT_CITY_MUNICIPALITY=Legazpi City
RESIDENT_PROVINCE=Albay

# ============================================================
# Barangay Master List
# ============================================================
# Every registration is compared with the official master list
# (collection master_residents, maintained by admins under
# Admin > Users > Masterlist or POST /api/admin/master-residents/import).
# A clean match with exactly one active record verifies the account at once;
# anything else waits in Admin > User Requests. A match shows the resident is
# on the list, not who is registering. Set to false to send every
# registration to admin review instead.
MASTER_LIST_AUTO_VERIFY=true

# Infant immunization in-app worker. Requires an active verified schedule version.
IMMUNIZATION_REMINDER_INTERVAL_MS=900000
IMMUNIZATION_REMINDERS_DISABLED=false

# Expo Push Service: enable only after installing the updated Android build.
EXPO_PUSH_ENABLED=false
# Optional server-only token if enhanced push security is enabled in EAS.
EXPO_ACCESS_TOKEN=
