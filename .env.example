# ============================================================
# MaslogCare Backend Environment Configuration
# Copy this file to .env and configure your values.
# NEVER commit .env into version control.
# ============================================================

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/maslogcare

# Server Configuration
PORT=3000
NODE_ENV=development
REQUEST_BODY_LIMIT=10mb

# Timezone for mission hours, day boundaries and appointment times in e-mails.
# Defaults to Asia/Manila; only change it if the health center is elsewhere.
# APP_TIMEZONE=Asia/Manila

# Set when the API runs behind a reverse proxy (nginx, Render, Railway, ...) so
# rate limits see the real client IP. Use the number of proxy hops; too high a
# number lets clients forge their address, too low makes visitors share one limit.
# Leave unset otherwise: X-Forwarded-For is then ignored, since any client can forge it.
# On Render the server warns at startup while this is unset.
# TRUST_PROXY=1

# Browser origins allowed to call this API and open realtime sockets, comma
# separated, as full origins (scheme and host, optional port). In development
# any localhost or private-network origin is also allowed, so Expo's moving
# web port and Wi-Fi address keep working. In production only these are, and
# the server refuses to start on an entry a browser could never send.
# CLIENT_ORIGINS=https://maslogcare.com

# JWT Secret (Use a strong random 256-bit string in production)
JWT_SECRET=replace_with_a_secure_jwt_secret_key_in_production

# MongoDB _id of the only administrator who may change resident web access.
# Not the ADM-... code shown in the app: that is derived from this id for display.
# Empty, malformed, or not an admin account means nobody can change it.
RESIDENT_WEB_ACCESS_ADMIN_ID=

# Default Admin Seed (Optional, used on initial database seed)
# Passwords for the default staff accounts, used only when the account is first
# created. An account whose variable is empty is not created. Never commit real values.
ADMIN_DEFAULT_PASSWORD=
ADMIN2_DEFAULT_PASSWORD=
MIDWIFE_DEFAULT_PASSWORD=
DOCTOR_DEFAULT_PASSWORD=
BHW_DEFAULT_PASSWORD=

# ============================================================
# Email / OTP Delivery Configuration
# ============================================================
# Enable or disable real email delivery.
# In development, setting EMAIL_ENABLED=false logs OTPs to the terminal
# and sends nothing to Brevo.
EMAIL_ENABLED=true

# Set to "mock" to simulate sending. Anything else uses Brevo.
EMAIL_PROVIDER=brevo

# Brevo transactional email API key. Server only, never commit a real value.
BREVO_API_KEY=

# Sender address, verified in Brevo under Senders or through an authenticated
# domain. The sender name is always MaslogCare.
BREVO_SENDER_EMAIL=barangay61.maslog@brevosend.com

# Rate Limiting & Cooldowns
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5

# ============================================================
# Resident Locality
# ============================================================
# MaslogCare serves a single barangay. The sign-up form shows the barangay as
# a locked field and the server overrides whatever the client sends, so this is
# the only place the value is set. City and province are defaults the resident
# may correct on the form.
RESIDENT_BARANGAY=Maslog
RESIDENT_CITY_MUNICIPALITY=Legazpi City
RESIDENT_PROVINCE=Albay

# ============================================================
# Barangay Master List
# ============================================================
# Every registration is compared with the official master list
# (collection master_residents, maintained by admins under
# Admin > Users > Masterlist or POST /api/admin/master-residents/import).
# A clean match with exactly one active record verifies the account at once;
# anything else waits in Admin > User Requests. A match shows the resident is
# on the list, not who is registering. Set to false to send every
# registration to admin review instead.
MASTER_LIST_AUTO_VERIFY=true

# Infant immunization in-app worker. Requires an active verified schedule version.
IMMUNIZATION_REMINDER_INTERVAL_MS=900000
IMMUNIZATION_REMINDERS_DISABLED=false
